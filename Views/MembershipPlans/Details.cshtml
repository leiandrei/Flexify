@model GymCrudApp.ViewModels.MembershipPlans.MembershipPlanViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Plan Details";
    var dailyRate = Model.DurationDays > 0 ? Model.PlanPrice / Model.DurationDays : Model.PlanPrice;
}

<header class="fx-page-head">
    <div class="fx-page-head__title">
        <span class="fx-avatar fx-avatar--lg" aria-hidden="true">@FlexifyUi.Initials(Model.PlanName)</span>
        <div class="fx-stack fx-stack--sm">
            <h1>@Model.PlanName</h1>
            <p class="fx-muted">@FlexifyUi.Peso(Model.PlanPrice) · @Model.DurationDays @(Model.DurationDays == 1 ? "day" : "days")</p>
        </div>
    </div>
    <div class="fx-row">
        <a asp-action="Index" class="fx-btn fx-btn--ghost">Back to list</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Delete" asp-route-id="@Model.PlanId" class="fx-btn fx-btn--danger-outline">Delete</a>
            <a asp-action="Edit" asp-route-id="@Model.PlanId" class="fx-btn fx-btn--primary">Edit plan</a>
        }
    </div>
</header>

<div class="fx-split">
    <section class="fx-card fx-split__main" aria-labelledby="plan-heading">
        <div class="fx-card__head">
            <h2 id="plan-heading">Plan details</h2>
            <span class="@FlexifyUi.StatusBadge(Model.IsActive ? "Active" : "Inactive")">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
        </div>
        <dl class="fx-kv-list">
            <div class="fx-kv"><dt>Price</dt><dd>@FlexifyUi.Peso(Model.PlanPrice)</dd></div>
            <div class="fx-kv"><dt>Duration</dt><dd>@Model.DurationDays @(Model.DurationDays == 1 ? "day" : "days")</dd></div>
            <div class="fx-kv"><dt>Effective daily rate</dt><dd>@FlexifyUi.Peso(dailyRate) / day</dd></div>
            <div class="fx-kv"><dt>Availability</dt><dd>@(Model.IsActive ? "Available for new sign-ups" : "Hidden from new sign-ups")</dd></div>
        </dl>
    </section>

    <section class="fx-card fx-split__side" aria-labelledby="description-heading">
        <div class="fx-card__head">
            <h2 id="description-heading">Description</h2>
        </div>
        <p class="fx-muted">@Model.PlanDescription</p>
    </section>
</div>