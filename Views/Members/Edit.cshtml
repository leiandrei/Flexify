@model GymCrudApp.ViewModels.Members.MemberEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit member";
}

<div class="fx-min fx-edit-page">
    <nav class="fx-crumbs" aria-label="Breadcrumb">
        <a asp-action="Index">Members</a>
        <span aria-hidden="true"> / </span>
        <a asp-action="Details" asp-route-id="@Model.MemberId">@Model.FullName</a>
        <span aria-hidden="true"> / </span>
        <span>Edit</span>
    </nav>

    <header class="fx-page-head">
        <div>
            <h1>Edit member</h1>
            <p class="fx-muted">Updates their profile and portal login email.</p>
        </div>
    </header>

    <form asp-action="Edit" method="post" class="fx-form fx-form--wide">
        <input type="hidden" asp-for="MemberId" />
        <div asp-validation-summary="ModelOnly" class="fx-field--full"></div>

        <div class="fx-field fx-field--full">
            <label asp-for="FullName" class="fx-label">Full name</label>
            <input asp-for="FullName" class="fx-input" autocomplete="name" />
            <span asp-validation-for="FullName" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <label asp-for="Email" class="fx-label">Email</label>
            <input asp-for="Email" class="fx-input" type="email" autocomplete="email" />
            <span class="fx-hint">Used to log in to the member portal.</span>
            <span asp-validation-for="Email" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <label asp-for="ContactNumber" class="fx-label">Contact number</label>
            <input asp-for="ContactNumber" class="fx-input" type="tel" placeholder="0917 123 4567" />
            <span asp-validation-for="ContactNumber" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <label asp-for="Birthdate" class="fx-label">Birthdate</label>
            <input asp-for="Birthdate" class="fx-input" type="date" />
            <span asp-validation-for="Birthdate" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <div class="fx-check">
                <input asp-for="IsActive" />
                <label asp-for="IsActive">Active account</label>
            </div>
            <span class="fx-hint">Off blocks portal login and check-in.</span>
        </div>

        <div class="fx-form__actions fx-field--full">
            <button type="submit" class="fx-btn fx-btn--primary">Save changes</button>
            <a asp-action="Details" asp-route-id="@Model.MemberId" class="fx-btn fx-btn--ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
