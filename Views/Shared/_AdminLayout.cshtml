@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => controller == c ? "fx-nav-link is-active" : "fx-nav-link";
    string? Current(string c) => controller == c ? "page" : null;
    var roleName = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Staff") ? "Staff" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Flexify</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymCrudApp.styles.css" asp-append-version="true" />
</head>
<body class="fx">
<div class="fx-admin">
    <nav class="fx-sidebar" aria-label="Main">
        <a class="fx-brand" asp-controller="@(User.IsInRole("Admin") ? "AdminDashboard" : "Members")" asp-action="Index">
            <partial name="_FxBrand" />
        </a>

        @if (User.IsInRole("Admin"))
        {
            <a class="@Active("AdminDashboard")" aria-current="@Current("AdminDashboard")" asp-controller="AdminDashboard" asp-action="Index">
                <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></svg>
                Dashboard
            </a>
        }

        <span class="fx-sidebar__label">Manage</span>
        <a class="@Active("Members")" aria-current="@Current("Members")" asp-controller="Members" asp-action="Index">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="4" /><path d="M2 21v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 6 6v1" /><path d="M16 4a4 4 0 0 1 0 8" /><path d="M22 21v-1a6 6 0 0 0-4-5.6" /></svg>
            Members
        </a>
        <a class="@Active("MembershipPlans")" aria-current="@Current("MembershipPlans")" asp-controller="MembershipPlans" asp-action="Index">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3" /><path d="M7 9h10" /><path d="M7 13h6" /></svg>
            Plans
        </a>
        <a class="@Active("Memberships")" aria-current="@Current("Memberships")" asp-controller="Memberships" asp-action="Index">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="3" /><circle cx="8" cy="12" r="2.5" /><path d="M14 10h4" /><path d="M14 14h4" /></svg>
            Memberships
        </a>
        <a class="@Active("Payments")" aria-current="@Current("Payments")" asp-controller="Payments" asp-action="Index">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="13" rx="3" /><path d="M2 10h20" /><path d="M6 15h4" /></svg>
            Payments
        </a>
        <a class="@Active("ReceiptOcr")" aria-current="@Current("ReceiptOcr")" asp-controller="ReceiptOcr" asp-action="Upload">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7V5a1 1 0 0 1 1-1h2" /><path d="M17 4h2a1 1 0 0 1 1 1v2" /><path d="M20 17v2a1 1 0 0 1-1 1h-2" /><path d="M7 20H5a1 1 0 0 1-1-1v-2" /><path d="M7 12h10" /></svg>
            Receipt OCR
        </a>
        <a class="@Active("Attendance")" aria-current="@Current("Attendance")" asp-controller="Attendance" asp-action="Index">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="3" /><path d="M3 9h18" /><path d="M8 2v4" /><path d="M16 2v4" /><path d="m9 15 2 2 4-4" /></svg>
            Attendance
        </a>

        @if (User.IsInRole("Admin"))
        {
            <span class="fx-sidebar__label">Admin</span>
            <a class="@Active("Staff")" aria-current="@Current("Staff")" asp-controller="Staff" asp-action="Index">
                <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.4 8 8 9 4.6-1 8-4.5 8-9V6z" /><path d="m9 12 2 2 4-4" /></svg>
                Staff
            </a>
        }

        <div class="fx-sidebar__user">
            <div class="fx-list-row">
                <span class="fx-avatar">@FlexifyUi.Initials(User.Identity?.Name)</span>
                <div class="fx-list-row__body">
                    <strong>@User.Identity?.Name</strong>
                    <span>@roleName</span>
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="fx-btn fx-btn--outline fx-btn--sm fx-btn--block">Log out</button>
            </form>
        </div>
    </nav>

    <main class="fx-main">
        <partial name="_FxAlerts" />
        @RenderBody()
    </main>
</div>

<partial name="_ChatbotWidget" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
