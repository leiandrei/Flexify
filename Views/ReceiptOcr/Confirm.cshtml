@model GymCrudApp.ViewModels.ReceiptOcr.ReceiptConfirmViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Check the details";
    var isPdf = !string.IsNullOrWhiteSpace(Model.ReceiptImagePath) &&
                Model.ReceiptImagePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
    var fileName = string.IsNullOrWhiteSpace(Model.ReceiptImagePath)
        ? "receipt"
        : System.IO.Path.GetFileName(Model.ReceiptImagePath);
}

<div class="fx-min fx-receipt">
    <header class="fx-page-head">
        <div>
            <nav class="fx-crumbs" aria-label="Breadcrumb">
                <a asp-controller="Payments" asp-action="Index">Payments</a>
                <span aria-hidden="true"> / </span>
                <a asp-action="Upload">Scan receipt</a>
                <span aria-hidden="true"> / </span>
                <span>Check</span>
            </nav>
            <h1>Check the details</h1>
            <p class="fx-muted">Nothing is saved until you press Save payment.</p>
        </div>
    </header>

    <div class="fx-split fx-receipt__split fx-receipt__split--even">
        @* Uploaded receipt and the text OCR read *@
        <section class="fx-split__side" aria-label="Uploaded receipt">
            <div class="fx-receipt__preview">
                @if (!string.IsNullOrWhiteSpace(Model.ReceiptImagePath))
                {
                    if (isPdf)
                    {
                        <div class="fx-receipt__preview-empty">
                            <span>@fileName</span>
                            <a href="@Model.ReceiptImagePath" target="_blank" rel="noopener" class="fx-btn fx-btn--outline fx-btn--sm">Open PDF</a>
                        </div>
                    }
                    else
                    {
                        <a href="@Model.ReceiptImagePath" target="_blank" rel="noopener">
                            <img src="@Model.ReceiptImagePath" alt="Uploaded payment receipt" />
                        </a>
                    }
                }
                else
                {
                    <div class="fx-receipt__preview-empty"><span class="fx-muted">No receipt preview</span></div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.OcrRawText))
            {
                <h2 class="fx-receipt__ocr-label">Text we read</h2>
                <pre class="fx-receipt__ocr-text">@Model.OcrRawText</pre>
            }
        </section>

        @* Prefilled fields to confirm before saving *@
        <form asp-action="Confirm" method="post" class="fx-form fx-split__main">
            <input type="hidden" asp-for="ReceiptImagePath" />
            <input type="hidden" asp-for="OcrRawText" />
            <input type="hidden" asp-for="ExtractedFieldCount" />
            <input type="hidden" asp-for="OcrFoundNothing" />

            <div asp-validation-summary="ModelOnly"></div>

            @if (Model.OcrFoundNothing)
            {
                <div class="fx-alert fx-alert--warn" role="status">
                    We couldn't read the fields automatically. Enter them from the receipt.
                </div>
            }
            else
            {
                <div class="fx-alert fx-alert--warn" role="status">
                    We found @Model.ExtractedFieldCount of 4 fields. Check the values below.
                </div>
            }

            <div class="fx-field">
                <label asp-for="MembershipId" class="fx-label">Member</label>
                <select asp-for="MembershipId" class="fx-select">
                    <option value="">Choose a member</option>
                    @foreach (var option in Model.AvailableMemberships)
                    {
                        <option value="@option.MembershipId">@option.DisplayLabel</option>
                    }
                </select>
                <span asp-validation-for="MembershipId" class="fx-error"></span>
            </div>

            <div class="fx-field">
                <label asp-for="Amount" class="fx-label">Amount</label>
                <input asp-for="Amount" class="fx-input" step="0.01" min="0.01" inputmode="decimal" />
                <span asp-validation-for="Amount" class="fx-error"></span>
            </div>

            <div class="fx-field">
                <label asp-for="PaymentType" class="fx-label">Payment method</label>
                <select asp-for="PaymentType" class="fx-select">
                    <option value="Cash">Cash</option>
                    <option value="GCash">GCash</option>
                    <option value="Maya">Maya</option>
                    <option value="Card">Card</option>
                    <option value="Bank Transfer">Bank Transfer</option>
                </select>
                <span asp-validation-for="PaymentType" class="fx-error"></span>
            </div>

            <div class="fx-field">
                <label asp-for="ReferenceNumber" class="fx-label">Reference number</label>
                <input asp-for="ReferenceNumber" class="fx-input" aria-describedby="ref-hint" />
                <span id="ref-hint" class="fx-hint">Required for non-cash payments. Fix any digits OCR missed.</span>
                <span asp-validation-for="ReferenceNumber" class="fx-error"></span>
            </div>

            <div class="fx-field">
                <label asp-for="PaymentDate" class="fx-label">Payment date</label>
                <input asp-for="PaymentDate" type="date" class="fx-input" />
                <span asp-validation-for="PaymentDate" class="fx-error"></span>
            </div>

            <div class="fx-form__actions">
                <button type="submit" class="fx-btn fx-btn--primary">Save payment</button>
                <a asp-action="Upload" class="fx-btn fx-btn--ghost">Rescan</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
