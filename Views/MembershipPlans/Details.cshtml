@model GymCrudApp.ViewModels.MembershipPlans.MembershipPlanViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.PlanName;
    var dailyRate = Model.DurationDays > 0 ? Model.PlanPrice / Model.DurationDays : Model.PlanPrice;
    var statusPill = Model.IsActive ? "is-active" : "is-inactive";
}

<div class="fx-min fx-member-detail fx-plan-detail">
    <nav class="fx-crumbs" aria-label="Breadcrumb">
        <a asp-action="Index">Plans</a>
        <span aria-hidden="true"> / </span>
        <span>@Model.PlanName</span>
    </nav>

    <header class="fx-page-head">
        <div class="fx-member-detail__who">
            <span class="fx-avatar fx-avatar--lg" aria-hidden="true">@FlexifyUi.Initials(Model.PlanName)</span>
            <div>
                <h1>@Model.PlanName</h1>
                <p class="fx-muted">
                    @FlexifyUi.Peso(Model.PlanPrice) · @Model.DurationDays @(Model.DurationDays == 1 ? "day" : "days")
                    · <span class="fx-members__pill @statusPill">@(Model.IsActive ? "Active" : "Inactive")</span>
                </p>
            </div>
        </div>
        <div class="fx-page-head__actions">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Delete" asp-route-id="@Model.PlanId" class="fx-btn fx-btn--danger-outline">Delete</a>
            }
            <a asp-action="Index" class="fx-btn fx-btn--ghost">Back to list</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.PlanId" class="fx-btn fx-btn--primary">Edit plan</a>
            }
        </div>
    </header>

    <div class="fx-member-detail__split">
        <section aria-labelledby="det-h">
            <h2 id="det-h">Plan details</h2>
            <dl class="fx-dl">
                <dt>Price</dt><dd>@FlexifyUi.Peso(Model.PlanPrice)</dd>
                <dt>Duration</dt><dd>@Model.DurationDays @(Model.DurationDays == 1 ? "day" : "days")</dd>
                <dt>Effective daily rate</dt><dd>@FlexifyUi.Peso(dailyRate) / day</dd>
                <dt>Availability</dt><dd>@(Model.IsActive ? "Available for new sign-ups" : "Hidden from new sign-ups")</dd>
            </dl>
        </section>
        <section aria-labelledby="desc-h">
            <h2 id="desc-h">Description</h2>
            <p class="fx-muted" style="line-height:1.55;max-width:42ch">
                @(string.IsNullOrWhiteSpace(Model.PlanDescription) ? "No description yet." : Model.PlanDescription)
            </p>
            <p class="fx-hint" style="margin-top:16px">Price and duration apply to new sales only. Existing memberships keep their dates.</p>
        </section>
    </div>
</div>
