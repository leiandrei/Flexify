@model GymCrudApp.ViewModels.Staff.StaffCreateViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "New staff";
}

<div class="fx-min fx-edit-page">
    <nav class="fx-crumbs" aria-label="Breadcrumb">
        <a asp-action="Index">Staff</a>
        <span aria-hidden="true"> / </span>
        <span>New staff</span>
    </nav>
    <header class="fx-page-head">
        <div>
            <h1>New staff</h1>
            <p class="fx-muted">Creates their profile and backoffice login in one step.</p>
        </div>
    </header>

    <form asp-action="Create" method="post" class="fx-form fx-form--wide">
        <div asp-validation-summary="ModelOnly" class="fx-field--full"></div>

        <div class="fx-field fx-field--full">
            <label asp-for="FullName" class="fx-label">Full name</label>
            <input asp-for="FullName" class="fx-input" autocomplete="name" placeholder="Maria Santos" />
            <span asp-validation-for="FullName" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <label asp-for="Email" class="fx-label">Email</label>
            <input asp-for="Email" class="fx-input" type="email" autocomplete="email" placeholder="maria.santos@flexify.ph" />
            <span class="fx-hint">Used to log in to the staff dashboard.</span>
            <span asp-validation-for="Email" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <label asp-for="Position" class="fx-label">Position</label>
            <input asp-for="Position" class="fx-input" placeholder="Front Desk / Strength Coach" />
            <span asp-validation-for="Position" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <label asp-for="DateOfBirth" class="fx-label">Birthdate</label>
            <input asp-for="DateOfBirth" class="fx-input" type="date" />
            <span asp-validation-for="DateOfBirth" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <label asp-for="InitialPassword" class="fx-label">Initial password</label>
            <input asp-for="InitialPassword" class="fx-input" type="password" autocomplete="new-password" />
            <span class="fx-hint">Share this once. They should change it after first login.</span>
            <span asp-validation-for="InitialPassword" class="fx-error"></span>
        </div>

        <div class="fx-form__actions fx-field--full">
            <button type="submit" class="fx-btn fx-btn--primary">Save staff</button>
            <a asp-action="Index" class="fx-btn fx-btn--ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
