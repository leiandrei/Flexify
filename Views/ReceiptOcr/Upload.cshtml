@model GymCrudApp.ViewModels.ReceiptOcr.ReceiptUploadViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Scan a receipt";
}

<div class="fx-min fx-receipt">
    <header class="fx-page-head">
        <div>
            <nav class="fx-crumbs" aria-label="Breadcrumb">
                <a asp-controller="Payments" asp-action="Index">Payments</a>
                <span aria-hidden="true"> / </span>
                <span>Scan receipt</span>
            </nav>
            <h1>Scan a receipt</h1>
            <p class="fx-muted">Upload a photo and we'll fill in the payment for you to check.</p>
        </div>
    </header>

    <div class="fx-split fx-receipt__split">
        @* Same form ids the OCR script in site.js expects *@
        <form id="receiptUploadForm" asp-action="Upload" method="post" enctype="multipart/form-data" class="fx-form fx-split__main">
            <input type="hidden" asp-for="ClientOcrRawText" id="clientOcrRawText" />
            <div asp-validation-summary="ModelOnly"></div>

            <label for="receiptFileInput" class="fx-receipt__drop">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 16V4m0 0-4 4m4-4 4 4M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" />
                </svg>
                <b id="receiptFileLabel">Choose a receipt photo</b>
                <span class="fx-muted">JPG or PNG, up to 5 MB</span>
                <input asp-for="ReceiptFile"
                       id="receiptFileInput"
                       type="file"
                       accept=".jpg,.jpeg,.png,.webp,.pdf,image/*,application/pdf"
                       class="visually-hidden" />
            </label>
            <span asp-validation-for="ReceiptFile" class="fx-error"></span>
            <p id="ocrStatusText" class="fx-muted fx-receipt__status" hidden></p>

            <div class="fx-form__actions">
                <button type="submit" id="extractSubmitBtn" class="fx-btn fx-btn--primary">Extract details</button>
                <a asp-controller="Payments" asp-action="Index" class="fx-btn fx-btn--ghost">Cancel</a>
            </div>
        </form>

        <aside class="fx-receipt__tips" aria-labelledby="ocr-tips-heading">
            <h2 id="ocr-tips-heading">For a good scan</h2>
            <ul>
                <li>Take a clear, well-lit photo, not blurry or tilted.</li>
                <li>Fit the whole receipt in the frame, amount and reference number included.</li>
                <li>GCash and Maya screenshots work too.</li>
                <li>You'll check every field before anything is saved.</li>
            </ul>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
    <script>
    (() => {
      const input = document.getElementById('receiptFileInput');
      const label = document.getElementById('receiptFileLabel');
      if (!input || !label) return;
      input.addEventListener('change', () => {
        const file = input.files && input.files[0];
        label.textContent = file ? file.name : 'Choose a receipt photo';
      });
    })();
    </script>
}
