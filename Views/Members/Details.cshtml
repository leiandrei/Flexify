@model GymCrudApp.ViewModels.Members.MemberDetailsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.FullName;
    var accountPill = Model.IsActive ? "is-active" : "is-inactive";
    var membershipPill = Model.MembershipStatus switch
    {
        "Active" => "is-active",
        "Expiring" => "is-expiring",
        "Expired" => "is-expired",
        _ => "is-inactive"
    };
    var hasPlan = !string.IsNullOrWhiteSpace(Model.CurrentPlanName);
    var planLabel = hasPlan
        ? (Model.CurrentPlanPrice.HasValue
            ? $"{Model.CurrentPlanName} · {FlexifyUi.Peso(Model.CurrentPlanPrice.Value)}"
            : Model.CurrentPlanName)
        : "No plan";
    var daysOf = Model.PlanDurationDays.HasValue && Model.DaysRemaining.HasValue
        ? $"{Model.DaysRemaining} of {Model.PlanDurationDays}"
        : (Model.DaysRemaining?.ToString() ?? "—");
}

<div class="fx-min fx-member-detail">
    <nav class="fx-crumbs" aria-label="Breadcrumb">
        <a asp-action="Index">Members</a>
        <span aria-hidden="true"> / </span>
        <span>@Model.FullName</span>
    </nav>

    <header class="fx-page-head">
        <div class="fx-member-detail__who">
            <span class="fx-avatar fx-avatar--lg @(Model.IsActive ? "" : "fx-avatar--neutral")" aria-hidden="true">@FlexifyUi.Initials(Model.FullName)</span>
            <div>
                <h1>@Model.FullName</h1>
                <p class="fx-muted">Member since @Model.JoinDate.ToString("MMM d, yyyy")</p>
            </div>
        </div>
        <div class="fx-page-head__actions">
            @if (Model.IsActive)
            {
                <a asp-action="Delete" asp-route-id="@Model.MemberId" class="fx-btn fx-btn--danger-outline">Deactivate</a>
            }
            <a asp-action="Edit" asp-route-id="@Model.MemberId" class="fx-btn fx-btn--ghost">Edit</a>
            @if (hasPlan)
            {
                <a asp-controller="Renewals" asp-action="Renew" asp-route-id="@Model.MemberId" class="fx-btn fx-btn--primary">Renew @Model.CurrentPlanName</a>
            }
            else
            {
                <a asp-controller="Payments" asp-action="Create" asp-route-memberId="@Model.MemberId" class="fx-btn fx-btn--primary">Sell a plan</a>
            }
        </div>
    </header>

    @if (Model.MembershipStatus == "Expiring" && Model.MembershipEndDate.HasValue && Model.DaysRemaining.HasValue)
    {
        var nextStart = Model.MembershipEndDate.Value.Date.AddDays(1);
        var daysWord = Model.DaysRemaining == 1 ? "day" : "days";
        var duration = Model.PlanDurationDays ?? 0;
        <div class="fx-alert fx-alert--warn" role="status">
            Membership ends in @Model.DaysRemaining @daysWord (@Model.MembershipEndDate.Value.ToString("MMM d, yyyy")).
            @if (duration > 0)
            {
                <text>Renewing now starts the next @duration days on @nextStart.ToString("MMM d").</text>
            }
        </div>
    }
    else if (Model.MembershipStatus == "Expired" && Model.MembershipEndDate.HasValue)
    {
        <div class="fx-alert fx-alert--danger" role="status">
            Membership expired on @Model.MembershipEndDate.Value.ToString("MMM d, yyyy"). Renew to restore access.
        </div>
    }

    <div class="fx-member-detail__split">
        <section aria-labelledby="prof-h">
            <h2 id="prof-h">Profile</h2>
            <dl class="fx-dl">
                <dt>Email</dt><dd>@Model.Email</dd>
                <dt>Contact number</dt><dd>@(string.IsNullOrWhiteSpace(Model.ContactNumber) ? "—" : Model.ContactNumber)</dd>
                <dt>Birthdate</dt><dd>@Model.Birthdate.ToString("MMM d, yyyy")</dd>
                <dt>Joined</dt><dd>@Model.JoinDate.ToString("MMM d, yyyy")</dd>
                <dt>Account</dt>
                <dd><span class="fx-members__pill @accountPill">@(Model.IsActive ? "Active" : "Inactive")</span></dd>
            </dl>
        </section>

        <section aria-labelledby="mem-h">
            <h2 id="mem-h">Current membership</h2>
            <dl class="fx-dl">
                <dt>Plan</dt><dd>@planLabel</dd>
                <dt>Started</dt><dd>@(Model.MembershipStartDate?.ToString("MMM d, yyyy") ?? "—")</dd>
                <dt>Ends</dt><dd>@(Model.MembershipEndDate?.ToString("MMM d, yyyy") ?? "—")</dd>
                <dt>Status</dt>
                <dd><span class="fx-members__pill @membershipPill">@Model.MembershipStatus</span></dd>
                <dt>Days remaining</dt>
                <dd>
                    @if (Model.DaysRemaining.HasValue && Model.PlanDurationDays.HasValue)
                    {
                        <b>@Model.DaysRemaining</b><text> of @Model.PlanDurationDays</text>
                    }
                    else
                    {
                        @daysOf
                    }
                </dd>
            </dl>
        </section>
    </div>

    <section class="fx-section" aria-labelledby="pay-h">
        <div class="fx-section__head">
            <h2 id="pay-h">Payments</h2>
            <a asp-controller="Payments" asp-action="Index" asp-route-memberSearch="@Model.FullName">All payments</a>
        </div>
        <div class="fx-table-wrap">
            <table class="fx-table">
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Plan</th>
                        <th scope="col">Method</th>
                        <th scope="col">Reference</th>
                        <th scope="col">Recorded by</th>
                        <th scope="col" class="fx-num">Amount</th>
                        <th scope="col" class="fx-th-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Payments.Any())
                    {
                        <tr><td colspan="7" class="fx-table__empty">No payments for this member yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var p in Model.Payments)
                        {
                            <tr class="@(p.IsVoided ? "is-void" : null)">
                                <td>@p.PaymentDate.ToString("MMM d, yyyy")</td>
                                <td>@p.PlanName</td>
                                <td>@p.PaymentType</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(p.ReferenceNumber))
                                    {
                                        <span class="fx-muted">—</span>
                                    }
                                    else
                                    {
                                        @p.ReferenceNumber
                                    }
                                </td>
                                <td>@p.RecordedByStaffName</td>
                                <td class="fx-num">@FlexifyUi.Peso(p.Amount)</td>
                                <td>
                                    <div class="fx-table__actions">
                                        @if (p.IsVoided)
                                        {
                                            <span class="fx-members__pill is-inactive">Voided</span>
                                        }
                                        else
                                        {
                                            <a asp-controller="Payments" asp-action="Void" asp-route-id="@p.PaymentId" class="fx-btn fx-btn--ghost fx-btn--sm">Void</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="fx-section" aria-labelledby="vis-h">
        <div class="fx-section__head">
            <h2 id="vis-h">Visits</h2>
            <a asp-controller="Attendance" asp-action="Index">Attendance</a>
        </div>
        <div class="fx-table-wrap">
            <table class="fx-table">
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Checked in</th>
                        <th scope="col">Checked out</th>
                        <th scope="col" class="fx-num">Time spent</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Visits.Any())
                    {
                        <tr><td colspan="4" class="fx-table__empty">No visits recorded yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var v in Model.Visits)
                        {
                            var dateLabel = v.CheckIn.Date == DateTime.Today
                                ? "Today"
                                : v.CheckIn.Date == DateTime.Today.AddDays(-1)
                                    ? "Yesterday"
                                    : v.CheckIn.ToString("MMM d");
                            <tr>
                                <td>@dateLabel</td>
                                <td>@v.CheckIn.ToString("h:mm tt")</td>
                                <td>@(v.CheckOut.HasValue ? v.CheckOut.Value.ToString("h:mm tt") : "—")</td>
                                <td class="fx-num">@v.TimeSpentLabel</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
