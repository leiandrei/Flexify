@model GymCrudApp.ViewModels.Members.MemberDetailsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.IsActive ? "Deactivate Member" : "Delete Inactive Member";
}

<header class="fx-page-head">
    <h1>@(Model.IsActive ? "Deactivate member" : "Delete inactive member")</h1>
</header>

<div class="fx-card fx-narrow">
    <dl class="fx-kv-list">
        <div class="fx-kv"><dt>Member</dt><dd>@Model.FullName</dd></div>
        <div class="fx-kv"><dt>Email</dt><dd>@Model.Email</dd></div>
        <div class="fx-kv"><dt>Contact</dt><dd>@Model.ContactNumber</dd></div>
        <div class="fx-kv"><dt>Join date</dt><dd>@Model.JoinDate.ToString("MMM d, yyyy")</dd></div>
        <div class="fx-kv"><dt>Status</dt><dd>@(Model.IsActive ? "Active" : "Inactive")</dd></div>
    </dl>

    @if (Model.IsActive)
    {
        <div class="fx-alert fx-alert--warn">
            Deactivating locks this member out of the member portal while preserving their payment and attendance history. Are you sure?
        </div>

        <form asp-action="Delete" asp-route-id="@Model.MemberId" method="post" class="fx-form__actions">
            <button type="submit" class="fx-btn fx-btn--danger">Confirm deactivation</button>
            <a asp-action="Index" class="fx-btn fx-btn--ghost">Cancel</a>
        </form>
    }
    else
    {
        <div class="fx-alert fx-alert--warn">
            This permanently deletes the member's profile and login account. Members with existing memberships, payments, or attendance logs cannot be deleted. Are you sure?
        </div>

        <form asp-action="PermanentDelete" asp-route-id="@Model.MemberId" method="post" class="fx-form__actions">
            <button type="submit" class="fx-btn fx-btn--danger">Permanently delete</button>
            <a asp-action="Index" class="fx-btn fx-btn--ghost">Cancel</a>
        </form>
    }
</div>