@using GymCrudApp
@using GymCrudApp.Models
@using GymCrudApp.Helpers
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model GymCrudApp.ViewModels.Staff.StaffDetailsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Staff";
}

<header class="fx-page-head">
    <h1>Delete staff</h1>
</header>

<div class="fx-card fx-narrow">
    <dl class="fx-kv-list">
        <div class="fx-kv"><dt>Name</dt><dd>@Model.FullName</dd></div>
        <div class="fx-kv"><dt>Email</dt><dd>@Model.Email</dd></div>
        <div class="fx-kv"><dt>Position</dt><dd>@Model.Position</dd></div>
        <div class="fx-kv"><dt>Date of birth</dt><dd>@Model.DateOfBirth.ToString("MMM d, yyyy")</dd></div>
        <div class="fx-kv"><dt>Status</dt><dd>@(Model.IsActive ? "Active" : "Inactive")</dd></div>
    </dl>

    <div class="fx-alert fx-alert--warn">
        Deleting this staff record removes their profile and revokes login access permanently. Are you sure?
    </div>

    <form asp-action="Delete" asp-route-id="@Model.StaffID" method="post" class="fx-form__actions">
        <button type="submit" class="fx-btn fx-btn--danger">Confirm delete</button>
        <a asp-action="Index" class="fx-btn fx-btn--ghost">Cancel</a>
    </form>
</div>