@model GymCrudApp.ViewModels.MembershipPlans.MembershipPlanViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Plan";
}

<header class="fx-page-head">
    <h1>Delete plan</h1>
</header>

<div class="fx-card fx-narrow">
    <dl class="fx-kv-list">
        <div class="fx-kv"><dt>Plan</dt><dd>@Model.PlanName</dd></div>
        <div class="fx-kv"><dt>Price</dt><dd>@FlexifyUi.Peso(Model.PlanPrice)</dd></div>
        <div class="fx-kv"><dt>Duration</dt><dd>@Model.DurationDays @(Model.DurationDays == 1 ? "day" : "days")</dd></div>
        <div class="fx-kv"><dt>Status</dt><dd>@(Model.IsActive ? "Active" : "Inactive")</dd></div>
    </dl>

    <div class="fx-alert fx-alert--warn">
        Deleting this plan removes it permanently. If members are still subscribed to this plan, deactivate it instead. Are you sure?
    </div>

    <form asp-action="Delete" asp-route-id="@Model.PlanId" method="post" class="fx-form__actions">
        <button type="submit" class="fx-btn fx-btn--danger">Confirm delete</button>
        <a asp-action="Index" class="fx-btn fx-btn--ghost">Cancel</a>
    </form>
</div>