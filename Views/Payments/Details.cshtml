@model GymCrudApp.ViewModels.Payments.PaymentDetailsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Payment · {Model.MemberName}";
    var statusPill = Model.IsVoided ? "is-expired" : "is-active";
    var statusLabel = Model.IsVoided ? "Voided" : "Completed";
}

<div class="fx-min fx-member-detail fx-payment-detail">
    <nav class="fx-crumbs" aria-label="Breadcrumb">
        <a asp-action="Index">Payments</a>
        <span aria-hidden="true"> / </span>
        <span>#@Model.PaymentId</span>
    </nav>

    <header class="fx-page-head">
        <div class="fx-member-detail__who">
            <span class="fx-avatar fx-avatar--lg" aria-hidden="true">@FlexifyUi.Initials(Model.MemberName)</span>
            <div>
                <h1>@FlexifyUi.Peso(Model.Amount)</h1>
                <p class="fx-muted">
                    @Model.MemberName · @Model.PlanName · <span class="fx-members__pill @statusPill">@statusLabel</span>
                </p>
            </div>
        </div>
        <div class="fx-page-head__actions">
            @if (!Model.IsVoided)
            {
                <a asp-action="Void" asp-route-id="@Model.PaymentId" class="fx-btn fx-btn--danger-outline">Void</a>
            }
            <a asp-action="Index" class="fx-btn fx-btn--ghost">Back to list</a>
            @if (!Model.IsVoided)
            {
                <a asp-action="Edit" asp-route-id="@Model.PaymentId" class="fx-btn fx-btn--primary">Edit</a>
            }
        </div>
    </header>

    <div class="fx-member-detail__split">
        <section aria-labelledby="pay-h">
            <h2 id="pay-h">Payment</h2>
            <dl class="fx-dl">
                <dt>Amount</dt><dd>₱@Model.Amount.ToString("N2")</dd>
                <dt>Method</dt><dd>@Model.PaymentType</dd>
                <dt>Status</dt>
                <dd><span class="fx-members__pill @statusPill">@statusLabel</span></dd>
                <dt>Paid on</dt><dd>@Model.PaymentDate.ToString("MMM d, yyyy")</dd>
                <dt>Reference</dt><dd>@(string.IsNullOrWhiteSpace(Model.ReferenceNumber) ? $"#{Model.PaymentId}" : Model.ReferenceNumber)</dd>
            </dl>
        </section>
        <section aria-labelledby="mem-h">
            <h2 id="mem-h">Membership</h2>
            <dl class="fx-dl">
                <dt>Member</dt>
                <dd><a asp-controller="Members" asp-action="Details" asp-route-id="@Model.MemberId">@Model.MemberName</a></dd>
                <dt>Plan</dt><dd>@Model.PlanName</dd>
                <dt>Coverage</dt>
                <dd>@Model.MembershipStartDate.ToString("MMM d, yyyy") → @Model.MembershipEndDate.ToString("MMM d, yyyy")</dd>
                <dt>Recorded by</dt><dd>@Model.RecordedByStaffName</dd>
            </dl>
            <p class="fx-hint" style="margin-top:16px">
                <a asp-controller="Memberships" asp-action="Details" asp-route-id="@Model.MembershipId">View membership</a>
            </p>
        </section>
    </div>
</div>
