@model GymCrudApp.ViewModels.Members.MemberIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Members";
}

<header class="fx-page-head">
    <div class="fx-stack fx-stack--sm">
        <h1>Members</h1>
        <p class="fx-muted">@Model.TotalCount @(Model.TotalCount == 1 ? "member" : "members")</p>
    </div>
    <a asp-action="Create" class="fx-btn fx-btn--primary">+ Register new member</a>
</header>

<form asp-action="Index" method="get" class="fx-search-bar" role="search">
    <div class="fx-field">
        <label class="fx-label" for="searchTerm">Search members</label>
        <input type="text" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" class="fx-input" placeholder="Name, email, or phone" />
    </div>
    <button type="submit" class="fx-btn fx-btn--primary">Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
    {
        <a asp-action="Index" class="fx-btn fx-btn--ghost">Clear</a>
    }
</form>

<div class="fx-table-wrap">
    <table class="fx-table">
        <thead>
            <tr>
                <th scope="col">Member</th>
                <th scope="col">Contact</th>
                <th scope="col">Join date</th>
                <th scope="col">Status</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Members.Any())
            {
                <tr><td colspan="5" class="fx-table__empty">No members found.</td></tr>
            }
            else
            {
                @foreach (var item in Model.Members)
                {
                    <tr>
                        <td>
                            <div class="fx-list-row">
                                <span class="fx-avatar @(item.IsActive ? "" : "fx-avatar--neutral")" aria-hidden="true">@FlexifyUi.Initials(item.FullName)</span>
                                <div class="fx-list-row__body">
                                    <strong>@item.FullName</strong>
                                    <span>@item.Email</span>
                                </div>
                            </div>
                        </td>
                        <td>@item.ContactNumber</td>
                        <td>@item.JoinDate.ToString("MMM d, yyyy")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="fx-badge fx-badge--active">Active</span>
                            }
                            else
                            {
                                <span class="fx-badge fx-badge--neutral">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="fx-table__actions">
                                <a asp-action="Details" asp-route-id="@item.MemberId" class="fx-btn fx-btn--ghost fx-btn--sm" aria-label="View @item.FullName">View</a>
                                <a asp-action="Edit" asp-route-id="@item.MemberId" class="fx-btn fx-btn--outline fx-btn--sm" aria-label="Edit @item.FullName">Edit</a>
                                @if (item.IsActive)
                                {
                                    <a asp-action="Delete" asp-route-id="@item.MemberId" class="fx-btn fx-btn--danger-outline fx-btn--sm" aria-label="Deactivate @item.FullName">Deactivate</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="fx-pagination" aria-label="Members pages">
        @if (Model.HasPreviousPage)
        {
            <a asp-action="Index" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
        }
        else
        {
            <span aria-disabled="true">Previous</span>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@i"
               aria-current="@(i == Model.CurrentPage ? "page" : null)">@i</a>
        }

        @if (Model.HasNextPage)
        {
            <a asp-action="Index" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
        }
        else
        {
            <span aria-disabled="true">Next</span>
        }
    </nav>
}
