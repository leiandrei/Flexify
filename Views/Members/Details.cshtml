@model GymCrudApp.ViewModels.Members.MemberDetailsViewModel
@{
    ViewData["Title"] = "Member Details";
}

<h2>Member Details</h2>
<dl class="row mt-3">
    <dt class="col-sm-3">Full Name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Contact Number</dt>
    <dd class="col-sm-9">@Model.ContactNumber</dd>

    <dt class="col-sm-3">Birthdate</dt>
    <dd class="col-sm-9">@Model.Birthdate.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Join Date</dt>
    <dd class="col-sm-9">@Model.JoinDate.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.MemberId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>