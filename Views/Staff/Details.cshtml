@model GymCrudApp.ViewModels.Staff.StaffDetailsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.FullName;
    var accountPill = Model.IsActive ? "is-active" : "is-inactive";
}

<div class="fx-min fx-member-detail fx-staff-detail">
    <nav class="fx-crumbs" aria-label="Breadcrumb">
        <a asp-action="Index">Staff</a>
        <span aria-hidden="true"> / </span>
        <span>@Model.FullName</span>
    </nav>

    <header class="fx-page-head">
        <div class="fx-member-detail__who">
            <span class="fx-avatar fx-avatar--lg @(Model.IsActive ? "" : "fx-avatar--neutral")" aria-hidden="true">@FlexifyUi.Initials(Model.FullName)</span>
            <div>
                <h1>@Model.FullName</h1>
                <p class="fx-muted">@Model.Position · @Model.Email</p>
            </div>
        </div>
        <div class="fx-page-head__actions">
            <a asp-action="Delete" asp-route-id="@Model.StaffID" class="fx-btn fx-btn--danger-outline">Delete</a>
            <a asp-action="Edit" asp-route-id="@Model.StaffID" class="fx-btn fx-btn--ghost">Edit</a>
        </div>
    </header>

    <div class="fx-member-detail__split fx-staff-detail__split">
        <section aria-labelledby="prof-h">
            <h2 id="prof-h">Profile</h2>
            <dl class="fx-dl">
                <dt>Email</dt><dd>@Model.Email</dd>
                <dt>Position</dt><dd>@Model.Position</dd>
                <dt>Date of birth</dt><dd>@Model.DateOfBirth.ToString("MMM d, yyyy")</dd>
                <dt>Account</dt>
                <dd><span class="fx-members__pill @accountPill">@(Model.IsActive ? "Active" : "Inactive")</span></dd>
            </dl>
        </section>

        <section aria-labelledby="access-h">
            <h2 id="access-h">Backoffice access</h2>
            <dl class="fx-dl">
                <dt>System role</dt><dd>Staff</dd>
                <dt>Sign-in</dt><dd>@(Model.IsActive ? "Enabled" : "Disabled")</dd>
                <dt>Can manage</dt><dd>Members, plans, payments, check-in</dd>
                <dt>Cannot</dt><dd>Staff accounts, business dashboard</dd>
            </dl>
        </section>
    </div>

    <section class="fx-section" aria-labelledby="pay-h">
        <div class="fx-section__head">
            <h2 id="pay-h">Payments recorded</h2>
            <a asp-controller="Payments" asp-action="Index">All payments</a>
        </div>
        <div class="fx-table-wrap">
            <table class="fx-table">
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Member</th>
                        <th scope="col">Plan</th>
                        <th scope="col">Method</th>
                        <th scope="col" class="fx-num">Amount</th>
                        <th scope="col" class="fx-th-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Payments.Any())
                    {
                        <tr><td colspan="6" class="fx-table__empty">No payments recorded by this staff yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var p in Model.Payments)
                        {
                            <tr class="@(p.IsVoided ? "is-void" : null)">
                                <td>@p.PaymentDate.ToString("MMM d, yyyy")</td>
                                <td>@p.MemberName</td>
                                <td>@p.PlanName</td>
                                <td>@p.PaymentType</td>
                                <td class="fx-num">@FlexifyUi.Peso(p.Amount)</td>
                                <td>
                                    <div class="fx-table__actions">
                                        @if (p.IsVoided)
                                        {
                                            <span class="fx-members__pill is-inactive">Voided</span>
                                        }
                                        else
                                        {
                                            <a asp-controller="Payments" asp-action="Void" asp-route-id="@p.PaymentId" class="fx-btn fx-btn--ghost fx-btn--sm">Void</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
