@model GymCrudApp.ViewModels.Staff.StaffDetailsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete staff";
    var statusLabel = Model.IsActive ? "Active" : "Inactive";
}

<div class="fx-min fx-delete-page">
    <nav class="fx-crumbs" aria-label="Breadcrumb">
        <a asp-action="Index">Staff</a>
        <span aria-hidden="true"> / </span>
        <a asp-action="Details" asp-route-id="@Model.StaffID">@Model.FullName</a>
        <span aria-hidden="true"> / </span>
        <span>Delete</span>
    </nav>

    <header class="fx-page-head">
        <div class="fx-member-detail__who">
            <span class="fx-avatar fx-avatar--lg @(Model.IsActive ? "" : "fx-avatar--neutral")" aria-hidden="true">@FlexifyUi.Initials(Model.FullName)</span>
            <div>
                <h1>Delete @Model.FullName?</h1>
            </div>
        </div>
        <div class="fx-page-head__actions">
            <a asp-action="Details" asp-route-id="@Model.StaffID" class="fx-btn fx-btn--ghost">Cancel</a>
            <form asp-action="Delete" asp-route-id="@Model.StaffID" method="post" class="fx-delete-page__form">
                <button type="submit" class="fx-btn fx-btn--danger">Delete account</button>
            </form>
        </div>
    </header>

    <p class="fx-delete-page__lede">This removes their staff profile and turns off backoffice login for good.</p>

    <div class="fx-kpis" style="--n:4">
        <div class="fx-kpi fx-kpi--wide"><span>Email</span><b>@Model.Email</b></div>
        <div class="fx-kpi"><span>Position</span><b>@Model.Position</b></div>
        <div class="fx-kpi"><span>Birthdate</span><b>@Model.DateOfBirth.ToString("MMM d, yyyy")</b></div>
        <div class="fx-kpi"><span>Status</span><b>@statusLabel</b></div>
    </div>

    <div class="fx-alert fx-alert--warn" role="status">
        Payments they already recorded stay on file under their name.
    </div>
</div>
