@model ErrorViewModel
@{
    Layout = null;
    ViewData["Title"] = "Something went wrong";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Flexify</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="fx">
    <div class="fx-denied">
        <div class="fx-denied__card">
            <a class="fx-brand fx-denied__brand" asp-controller="Home" asp-action="Index">
                <partial name="_FxBrand" />
            </a>
            <p class="fx-denied__code">Error</p>
            <h1>Something went wrong</h1>
            <p>We couldn’t finish that request. Try again, or go back home and continue from there.</p>
            @if (Model.ShowRequestId)
            {
                <p class="fx-denied__meta">Request ID · <code>@Model.RequestId</code></p>
            }
            <div class="fx-denied__actions">
                <a class="fx-btn fx-btn--primary" asp-controller="Home" asp-action="Index">Back to home</a>
            </div>
        </div>
    </div>
</body>
</html>
