@model GymCrudApp.ViewModels.Attendance.AttendanceIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Attendance";
    var isAdmin = User.IsInRole("Admin");
    var isToday = Model.FilterDate.Date == DateTime.Today;
}
 
<header class="fx-page-head">
    <div class="fx-stack fx-stack--sm">
        <h1>Attendance</h1>
        <p class="fx-muted">Search a member to check them in.</p>
    </div>
</header>
 
@* 1. Member search for check-in *@
<form asp-action="Index" method="get" class="fx-search-bar" role="search">
    <div class="fx-field">
        <label class="fx-label" for="searchQuery">Find member</label>
        <input type="text" id="searchQuery" name="searchQuery" value="@Model.SearchQuery" class="fx-input" placeholder="Name, email, or phone" />
    </div>
    <input type="hidden" name="filterDate" value="@Model.FilterDate.ToString("yyyy-MM-dd")" />
    <button type="submit" class="fx-btn fx-btn--primary">Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
    {
        <a asp-action="Index" class="fx-btn fx-btn--ghost">Clear</a>
    }
</form>
 
@if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
{
    <section class="fx-card" aria-labelledby="results-heading">
        <div class="fx-card__head">
            <h2 id="results-heading">Search results</h2>
        </div>
        @if (!Model.MatchingMembers.Any())
        {
            <p class="fx-muted">No members match "@Model.SearchQuery".</p>
        }
        else
        {
            <div class="fx-kv-list">
                @foreach (var m in Model.MatchingMembers)
                {
                    <div class="fx-kv">
                        <div class="fx-list-row">
                            <span class="fx-avatar" aria-hidden="true">@FlexifyUi.Initials(m.FullName)</span>
                            <div class="fx-list-row__body">
                                <strong>@m.FullName</strong>
                                <span>@(m.PlanName ?? "No plan") @(m.ExpiryDate.HasValue ? "· until " + m.ExpiryDate.Value.ToString("MMM d, yyyy") : "")</span>
                            </div>
                        </div>
                        <div class="fx-row">
                            <span class="@FlexifyUi.StatusBadge(m.MembershipStatus)">@m.MembershipStatus</span>
                            @if (m.HasOpenCheckInToday)
                            {
                                <span class="fx-badge fx-badge--neutral">Already in gym</span>
                            }
                            else if (m.CanCheckIn)
                            {
                                <form asp-action="CheckIn" method="post">
                                    <input type="hidden" name="memberId" value="@m.MemberId" />
                                    <input type="hidden" name="searchQuery" value="@Model.SearchQuery" />
                                    <button type="submit" class="fx-btn fx-btn--primary fx-btn--sm">Check in</button>
                                </form>
                            }
                            else
                            {
                                <span class="fx-muted">Renew membership first</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}
 
@* 2. Attendance log for one day *@
<section class="fx-stack fx-stack--sm" aria-labelledby="log-heading">
    <div class="fx-page-head">
        <h2 id="log-heading">@(isToday ? "Today's visits" : "Visits on " + Model.FilterDate.ToString("MMM d, yyyy"))</h2>
        <form asp-action="Index" method="get" class="fx-row">
            <label class="fx-label" for="filterDate">Date</label>
            <input type="date" id="filterDate" name="filterDate" value="@Model.FilterDate.ToString("yyyy-MM-dd")" class="fx-input" />
            <button type="submit" class="fx-btn fx-btn--outline fx-btn--sm">Show</button>
        </form>
    </div>
 
    <div class="fx-table-wrap">
        <table class="fx-table">
            <thead>
                <tr>
                    <th scope="col">Member</th>
                    <th scope="col">Check in</th>
                    <th scope="col">Check out</th>
                    <th scope="col">Duration</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Records.Any())
                {
                    <tr><td colspan="5" class="fx-table__empty">No visits recorded for this day.</td></tr>
                }
                else
                {
                    @foreach (var r in Model.Records)
                    {
                        <tr>
                            <td>
                                <strong>@r.MemberName</strong>
                                <span class="fx-sub">@r.MemberEmail</span>
                            </td>
                            <td>@r.CheckIn.ToString("h:mm tt")</td>
                            <td>@(r.CheckOut?.ToString("h:mm tt") ?? "-")</td>
                            <td>
                                @if (r.IsOpen)
                                {
                                    <span class="fx-badge fx-badge--active">In gym</span>
                                }
                                else
                                {
                                    @r.DurationDisplay
                                }
                            </td>
                            <td>
                                <div class="fx-table__actions">
                                    @if (r.IsOpen)
                                    {
                                        <form asp-action="CheckOut" method="post">
                                            <input type="hidden" name="attendanceId" value="@r.AttendanceId" />
                                            <input type="hidden" name="filterDate" value="@Model.FilterDate.ToString("yyyy-MM-dd")" />
                                            <button type="submit" class="fx-btn fx-btn--outline fx-btn--sm">Check out</button>
                                        </form>
                                    }
                                    @if (isAdmin)
                                    {
                                        <a asp-action="Delete" asp-route-id="@r.AttendanceId" class="fx-btn fx-btn--danger-outline fx-btn--sm" aria-label="Delete visit by @r.MemberName">Delete</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
 