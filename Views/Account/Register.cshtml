@model GymCrudApp.ViewModels.Account.RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create your account";
    ViewData["AuthNavText"] = "Log in";
    ViewData["AuthNavAction"] = "Login";
    var maxBirth = DateTime.Today.AddYears(-16).ToString("yyyy-MM-dd");
    var minBirth = "1900-01-01";
}

<div class="fx-auth-box">
    <h1>Create your account</h1>
    <p class="fx-auth-box__lead">Sign up to track your membership, payments, and gym visits.</p>

    <form asp-action="Register" method="post" class="fx-form fx-auth-form" id="registerForm" autocomplete="on">
        <div asp-validation-summary="ModelOnly"></div>

        <div class="fx-field">
            <label asp-for="FullName" class="fx-label">Full name</label>
            <input asp-for="FullName" class="fx-input" autocomplete="name" />
            <span asp-validation-for="FullName" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <label asp-for="Email" class="fx-label">Email</label>
            <input asp-for="Email" class="fx-input" type="email" autocomplete="email" placeholder="you@email.com" />
            <span asp-validation-for="Email" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <label asp-for="ContactNumber" class="fx-label">Contact number</label>
            <input asp-for="ContactNumber" class="fx-input" type="tel" autocomplete="tel" placeholder="0917 123 4567" />
            <span asp-validation-for="ContactNumber" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <label asp-for="Birthdate" class="fx-label">Birthdate</label>
            <input asp-for="Birthdate" class="fx-input" type="date" min="@minBirth" max="@maxBirth" />
            <span asp-validation-for="Birthdate" class="fx-error"></span>
            <span class="fx-hint">Must be 16 or older. Future dates aren’t allowed.</span>
        </div>

        <div class="fx-field">
            <label asp-for="Password" class="fx-label">Password</label>
            <div class="fx-password">
                <input asp-for="Password" class="fx-input" autocomplete="new-password" data-password-input />
                <button type="button" class="fx-password__toggle" data-password-toggle aria-label="Show password" aria-pressed="false">
                    <svg class="fx-password__icon fx-password__icon--show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                    <svg class="fx-password__icon fx-password__icon--hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                        <circle cx="12" cy="12" r="3" />
                        <path d="m4 4 16 16" />
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="fx-error"></span>
            <span class="fx-hint">At least 8 characters, with a letter and a number.</span>
        </div>

        <div class="fx-field">
            <label asp-for="ConfirmPassword" class="fx-label">Confirm password</label>
            <div class="fx-password">
                <input asp-for="ConfirmPassword" class="fx-input" autocomplete="new-password" data-password-input />
                <button type="button" class="fx-password__toggle" data-password-toggle aria-label="Show password" aria-pressed="false">
                    <svg class="fx-password__icon fx-password__icon--show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                    <svg class="fx-password__icon fx-password__icon--hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                        <circle cx="12" cy="12" r="3" />
                        <path d="m4 4 16 16" />
                    </svg>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="fx-error"></span>
        </div>

        <button type="submit" class="fx-btn fx-btn--primary fx-btn--lg fx-btn--block">Create account</button>
        <p class="fx-hint fx-auth-form__note">Then pay at the front desk to start your plan. This app doesn’t take payments online.</p>
    </form>

    <p class="fx-auth-box__alt">Already a member? <a asp-action="Login">Log in</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (() => {
      document.querySelectorAll('[data-password-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const wrap = btn.closest('.fx-password');
          const input = wrap?.querySelector('[data-password-input]');
          if (!input) return;
          const show = input.type === 'password';
          input.type = show ? 'text' : 'password';
          btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
          btn.setAttribute('aria-pressed', show ? 'true' : 'false');
          const eye = btn.querySelector('.fx-password__icon--show');
          const eyeOff = btn.querySelector('.fx-password__icon--hide');
          if (eye) eye.hidden = show;
          if (eyeOff) eyeOff.hidden = !show;
        });
      });
    })();
    </script>
}
