@model GymCrudApp.ViewModels.MembershipPlans.MembershipPlanFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "New plan";
}

<div class="fx-min fx-edit-page">
    <nav class="fx-crumbs" aria-label="Breadcrumb">
        <a asp-action="Index">Plans</a>
        <span aria-hidden="true"> / </span>
        <span>New plan</span>
    </nav>
    <header class="fx-page-head">
        <div>
            <h1>New plan</h1>
            <p class="fx-muted">Name, price, and duration for new sales. Existing memberships keep their dates.</p>
        </div>
    </header>

    <form asp-action="Create" method="post" class="fx-form fx-form--wide">
        <div asp-validation-summary="ModelOnly" class="fx-field--full"></div>

        <div class="fx-field fx-field--full">
            <label asp-for="PlanName" class="fx-label">Plan name</label>
            <input asp-for="PlanName" class="fx-input" placeholder="e.g. Monthly Unlimited" />
            <span asp-validation-for="PlanName" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <label asp-for="PlanPrice" class="fx-label">Price (₱)</label>
            <input asp-for="PlanPrice" class="fx-input" step="0.01" min="0.01" placeholder="1500" />
            <span asp-validation-for="PlanPrice" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <label asp-for="DurationDays" class="fx-label">Duration (days)</label>
            <input asp-for="DurationDays" class="fx-input" min="1" max="3650" placeholder="30" />
            <span class="fx-hint">Used when selling or renewing this plan.</span>
            <span asp-validation-for="DurationDays" class="fx-error"></span>
        </div>

        <div class="fx-field fx-field--full">
            <label asp-for="PlanDescription" class="fx-label">Description</label>
            <textarea asp-for="PlanDescription" class="fx-textarea" rows="4" placeholder="What’s included for members on this plan…"></textarea>
            <span asp-validation-for="PlanDescription" class="fx-error"></span>
        </div>

        <div class="fx-field fx-field--full">
            <div class="fx-check">
                <input asp-for="IsActive" />
                <label asp-for="IsActive">Active plan</label>
            </div>
            <span class="fx-hint">Inactive plans are hidden when selling a plan.</span>
        </div>

        <div class="fx-form__actions fx-field--full">
            <button type="submit" class="fx-btn fx-btn--primary">Save plan</button>
            <a asp-action="Index" class="fx-btn fx-btn--ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
