@model GymCrudApp.ViewModels.Payments.PaymentDetailsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Payment Details";
}
 
<header class="fx-page-head">
    <div class="fx-page-head__title">
        <span class="fx-avatar fx-avatar--lg" aria-hidden="true">@FlexifyUi.Initials(Model.MemberName)</span>
        <div class="fx-stack fx-stack--sm" style="gap:4px;min-width:0">
            <h1>@FlexifyUi.Peso(Model.Amount)</h1>
            <p class="fx-muted">@Model.MemberName · @Model.MemberEmail</p>
        </div>
    </div>
    <div class="fx-row">
        <a asp-action="Index" class="fx-btn fx-btn--ghost">Back to list</a>
        @if (!Model.IsVoided)
        {
            <a asp-action="Void" asp-route-id="@Model.PaymentId" class="fx-btn fx-btn--danger-outline">Void</a>
            <a asp-action="Edit" asp-route-id="@Model.PaymentId" class="fx-btn fx-btn--primary">Edit payment</a>
        }
    </div>
</header>
 
<div class="fx-split">
    <section class="fx-card fx-split__main" aria-labelledby="payment-heading">
        <div class="fx-card__head">
            <h2 id="payment-heading">Payment</h2>
            @if (Model.IsVoided)
            {
                <span class="fx-badge fx-badge--overdue">Voided</span>
            }
            else
            {
                <span class="fx-badge fx-badge--active">Paid</span>
            }
        </div>
        <dl class="fx-kv-list">
            <div class="fx-kv"><dt>Amount</dt><dd>@FlexifyUi.Peso(Model.Amount)</dd></div>
            <div class="fx-kv"><dt>Method</dt><dd>@Model.PaymentType</dd></div>
            <div class="fx-kv"><dt>Reference number</dt><dd>@(Model.ReferenceNumber ?? "-")</dd></div>
            <div class="fx-kv"><dt>Payment date</dt><dd>@Model.PaymentDate.ToString("MMM d, yyyy")</dd></div>
            <div class="fx-kv"><dt>Recorded by</dt><dd>@Model.RecordedByStaffName</dd></div>
        </dl>
    </section>
 
    <section class="fx-card fx-split__side" aria-labelledby="membership-heading">
        <div class="fx-card__head">
            <h2 id="membership-heading">Membership</h2>
        </div>
        <dl class="fx-kv-list">
            <div class="fx-kv"><dt>Plan</dt><dd>@Model.PlanName</dd></div>
            <div class="fx-kv"><dt>Start</dt><dd>@Model.MembershipStartDate.ToString("MMM d, yyyy")</dd></div>
            <div class="fx-kv"><dt>End</dt><dd>@Model.MembershipEndDate.ToString("MMM d, yyyy")</dd></div>
        </dl>
        <a asp-controller="Memberships" asp-action="Details" asp-route-id="@Model.MembershipId" class="fx-btn fx-btn--outline fx-btn--sm">View membership</a>
    </section>
</div>
 