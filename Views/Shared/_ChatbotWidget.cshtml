<div id="fxChatbot" class="fx-chat" data-prompts-url="@Url.Action("Prompts", "Chatbot")" data-ask-url="@Url.Action("Ask", "Chatbot")">
    <section id="fxChatWindow" class="fx-chat__window" role="dialog" aria-label="Flexify Assistant" hidden>
        <header class="fx-chat__head">
            <img src="~/assets/gym-robot-logo-chat-bubble-flexify-v2.png" alt="" class="fx-chat__avatar" />
            <div class="fx-chat__who">
                <strong class="fx-chat__title">Flexify Assistant</strong>
                <span class="fx-chat__status"><i class="fx-chat__dot" aria-hidden="true"></i> Online · plans &amp; hours</span>
            </div>
            <button type="button" id="fxChatClose" class="fx-chat__close" aria-label="Close chat">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                    <path d="M18 6 6 18" /><path d="m6 6 12 12" />
                </svg>
            </button>
        </header>

        <div id="fxChatMessages" class="fx-chat__messages" aria-live="polite">
            <div class="fx-chat__msg fx-chat__msg--bot">
                <p class="fx-chat__p">Hi — ask about plans, pricing, hours, or your membership.</p>
            </div>
        </div>

        <div class="fx-chat__foot">
            <div id="fxChatPrompts" class="fx-chat__prompts" aria-label="Suggested questions"></div>

            <form id="fxChatForm" class="fx-chat__form" autocomplete="off">
                <label for="fxChatInput" class="visually-hidden">Ask a question</label>
                <input type="text"
                       id="fxChatInput"
                       class="fx-chat__input"
                       maxlength="500"
                       placeholder="Ask anything…"
                       required />
                <button type="submit" id="fxChatSend" class="fx-chat__send" aria-label="Send message">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
                    </svg>
                </button>
            </form>
        </div>
    </section>

    <button type="button"
            id="fxChatToggle"
            class="fx-chat__launcher"
            aria-expanded="false"
            aria-controls="fxChatWindow"
            aria-label="Open Flexify Assistant">
        <img src="~/assets/gym-robot-logo-chat-bubble-flexify-v2.png" alt="" class="fx-chat__launcher-img" />
        Ask Flexify
    </button>
</div>
