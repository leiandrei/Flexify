<div id="fxChatbot" class="fx-chat" data-prompts-url="@Url.Action("Prompts", "Chatbot")" data-ask-url="@Url.Action("Ask", "Chatbot")">
    <section id="fxChatWindow" class="fx-chat__window" role="dialog" aria-label="Flexify Gym Assistant" hidden>
        <header class="fx-chat__head">
            <div class="fx-chat__identity">
                <img src="~/assets/gym-robot-logo-chat-bubble-flexify-v2.png" alt="Flexify Assistant" class="fx-chat__avatar" />
                <div>
                    <strong class="fx-chat__title">Flexify Assistant</strong>
                    <span class="fx-chat__status">Online · Ask about plans &amp; memberships</span>
                </div>
            </div>
            <button type="button" id="fxChatClose" class="fx-chat__close" aria-label="Close chat">
                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 6 6 18" /><path d="m6 6 12 12" />
                </svg>
            </button>
        </header>

        <div id="fxChatMessages" class="fx-chat__messages" aria-live="polite">
            <div class="fx-chat__msg fx-chat__msg--bot">
                Hi! I’m the Flexify Assistant. Ask me about membership plans, pricing, gym hours, or your active subscription.
            </div>
        </div>

        <div id="fxChatPrompts" class="fx-chat__prompts" aria-label="Suggested questions"></div>

        <form id="fxChatForm" class="fx-chat__form" autocomplete="off">
            <label for="fxChatInput" class="visually-hidden">Type your question</label>
            <input type="text"
                   id="fxChatInput"
                   class="fx-input fx-chat__input"
                   maxlength="500"
                   placeholder="Ask a question..."
                   required />
            <button type="submit" id="fxChatSend" class="fx-btn fx-btn--primary fx-btn--sm" aria-label="Send message">Send</button>
        </form>
    </section>

    <button type="button"
            id="fxChatToggle"
            class="fx-chat__launcher"
            aria-expanded="false"
            aria-controls="fxChatWindow"
            aria-label="Open Flexify Assistant">
        <img src="~/assets/gym-robot-logo-chat-bubble-flexify-v2.png" alt="" class="fx-chat__launcher-img" />
    </button>
</div>