@model GymCrudApp.ViewModels.Memberships.MembershipCreateViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Assign a plan";
}

<div class="fx-min fx-edit-page">
    <nav class="fx-crumbs" aria-label="Breadcrumb">
        <a asp-action="Index">Memberships</a>
        <span aria-hidden="true"> / </span>
        <span>Assign a plan</span>
    </nav>
    <header class="fx-page-head">
        <div>
            <h1>Assign a plan</h1>
            <p class="fx-muted">End date is calculated from the plan’s duration. Prefer Sell a plan when collecting payment now.</p>
        </div>
    </header>

    <form asp-action="Create" method="post" class="fx-form fx-form--wide">
        <div asp-validation-summary="ModelOnly" class="fx-field--full"></div>

        <div class="fx-field">
            <label asp-for="MemberId" class="fx-label">Member</label>
            <select asp-for="MemberId" asp-items="Model.Members" class="fx-select">
                <option value="">Choose a member</option>
            </select>
            <span asp-validation-for="MemberId" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <label asp-for="PlanId" class="fx-label">Plan</label>
            <select asp-for="PlanId" asp-items="Model.Plans" class="fx-select">
                <option value="">Choose a plan</option>
            </select>
            <span asp-validation-for="PlanId" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <label asp-for="StartDate" class="fx-label">Start date</label>
            <input asp-for="StartDate" class="fx-input" type="date" />
            <span class="fx-hint">End date is set from the plan duration after you save.</span>
            <span asp-validation-for="StartDate" class="fx-error"></span>
        </div>

        <div class="fx-field">
            <label class="fx-label">End date</label>
            <input class="fx-input" value="Computed from plan" disabled />
            <span class="fx-hint">Computed from the plan duration. Not editable here.</span>
        </div>

        <div class="fx-form__actions fx-field--full">
            <button type="submit" class="fx-btn fx-btn--primary">Assign plan</button>
            <a asp-action="Index" class="fx-btn fx-btn--ghost">Cancel</a>
            <a asp-controller="Payments" asp-action="Create" class="fx-btn fx-btn--quiet">Sell a plan instead</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
