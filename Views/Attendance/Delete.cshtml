@model GymCrudApp.ViewModels.Attendance.AttendanceListItemViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete visit";
    var checkOutLabel = Model.CheckOut?.ToString("h:mm tt") ?? "Still in";
}

<div class="fx-min fx-delete-page">
    <nav class="fx-crumbs" aria-label="Breadcrumb">
        <a asp-action="Index">Check-in</a>
        <span aria-hidden="true"> / </span>
        <span>Delete visit</span>
    </nav>

    <header class="fx-page-head">
        <div class="fx-member-detail__who">
            <span class="fx-avatar fx-avatar--lg" aria-hidden="true">@FlexifyUi.Initials(Model.MemberName)</span>
            <div>
                <h1>Delete @Model.MemberName’s visit?</h1>
            </div>
        </div>
        <div class="fx-page-head__actions">
            <a asp-action="Index" class="fx-btn fx-btn--ghost">Cancel</a>
            <form asp-action="Delete" asp-route-id="@Model.AttendanceId" method="post" class="fx-delete-page__form">
                <button type="submit" class="fx-btn fx-btn--danger">Delete visit</button>
            </form>
        </div>
    </header>

    <p class="fx-delete-page__lede">This removes the check-in from the attendance log. It can’t be undone.</p>

    <div class="fx-kpis" style="--n:4">
        <div class="fx-kpi"><span>Plan</span><b>@Model.PlanName</b></div>
        <div class="fx-kpi"><span>Check in</span><b>@Model.CheckIn.ToString("h:mm tt")</b></div>
        <div class="fx-kpi"><span>Check out</span><b>@checkOutLabel</b></div>
        <div class="fx-kpi"><span>Duration</span><b>@Model.DurationDisplay</b></div>
    </div>

    <div class="fx-alert fx-alert--warn" role="status">
        @Model.CheckIn.ToString("MMM d, yyyy") · deleting a visit does not change their membership.
    </div>
</div>
