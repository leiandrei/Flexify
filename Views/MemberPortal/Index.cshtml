@model GymCrudApp.ViewModels.MemberPortal.MemberPortalViewModel
@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "My Membership";
}

<header class="fx-member__top">
    <div class="fx-list-row">
        <span class="fx-avatar" aria-hidden="true">@FlexifyUi.Initials(Model.FullName)</span>
        <div class="fx-list-row__body">
            <strong>Hi, @Model.FullName</strong>
            <span>@Model.Email</span>
        </div>
    </div>
    <a asp-controller="Home" asp-action="Index" class="fx-btn fx-btn--ghost fx-btn--sm">&larr; Home page</a>
</header>

<div class="fx-member__body">

    @* 1. Membership card *@
    <section class="fx-member-card" aria-labelledby="card-heading">
        <div class="fx-member-card__head">
            <span class="fx-member-card__type" id="card-heading">@(Model.PlanName ?? "No plan yet")</span>
            <span class="@FlexifyUi.StatusBadge(Model.MembershipStatus)">@Model.MembershipStatus</span>
        </div>
        <div class="fx-member-card__id">Member #@Model.MemberId</div>
    </section>

    @* 2. Days remaining and dates *@
    @if (Model.ExpiryDate.HasValue)
    {
        <section class="fx-stat @(Model.MembershipStatus == "Active" ? "" : "fx-stat--warn")" aria-label="Days remaining">
            <span class="fx-stat__label">Days remaining</span>
            <span class="fx-stat__value">@Model.DaysRemaining</span>
            <span class="fx-stat__hint">
                @(Model.StartDate?.ToString("MMM d, yyyy")) to @Model.ExpiryDate.Value.ToString("MMM d, yyyy")
            </span>
        </section>
    }
    else
    {
        <div class="fx-alert fx-alert--warn" role="status">
            You don't have a membership yet. Visit the front desk to choose a plan.
        </div>
    }

    @* 3. Payment history *@
    <section class="fx-card" aria-labelledby="payments-heading">
        <div class="fx-card__head">
            <h2 id="payments-heading">Payment history</h2>
        </div>
        @if (Model.Payments.Any())
        {
            <div class="fx-kv-list">
                @foreach (var p in Model.Payments)
                {
                    <div class="fx-kv">
                        <div class="fx-list-row__body">
                            <strong>@p.PlanName</strong>
                            <span>@p.PaymentDate.ToString("MMM d, yyyy") · @p.PaymentType @(p.ReferenceNumber != null ? "· " + p.ReferenceNumber : "")</span>
                        </div>
                        @if (p.IsVoided)
                        {
                            <span class="fx-badge fx-badge--overdue">Voided</span>
                        }
                        else
                        {
                            <strong>@FlexifyUi.Peso(p.Amount)</strong>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p class="fx-muted">No payments yet.</p>
        }
    </section>

    @* 4. Attendance history *@
    <section class="fx-card" aria-labelledby="attendance-heading">
        <div class="fx-card__head">
            <h2 id="attendance-heading">Gym visits</h2>
        </div>
        @if (Model.AttendanceLogs.Any())
        {
            <div class="fx-kv-list">
                @foreach (var a in Model.AttendanceLogs)
                {
                    <div class="fx-kv">
                        <div class="fx-list-row__body">
                            <strong>@a.CheckIn.ToString("ddd, MMM d")</strong>
                            <span>
                                In @a.CheckIn.ToString("h:mm tt")
                                @if (a.CheckOut.HasValue)
                                {
                                    <text>· Out @a.CheckOut.Value.ToString("h:mm tt")</text>
                                }
                            </span>
                        </div>
                        <span class="fx-list-row__time">@a.DurationDisplay</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="fx-muted">No visits recorded yet.</p>
        }
    </section>

</div>

<style>
    @@media (min-width: 900px) {
        .fx-member {
            max-width: 960px;
        }

        .fx-member__body {
            display: grid;
            grid-template-columns: 1fr 1fr;
            align-items: start;
            align-content: start;
        }

        .fx-bottom-nav {
            max-width: none;
            padding-inline: max(8px, calc((100vw - 960px) / 2));
        }
    }
</style>
 