@{
    var firstName = User.Identity?.Name?
        .Split('@', StringSplitOptions.RemoveEmptyEntries)
        .FirstOrDefault()?
        .Split('.', StringSplitOptions.RemoveEmptyEntries)
        .FirstOrDefault() ?? "Member";
    if (!string.IsNullOrEmpty(firstName))
    {
        firstName = char.ToUpperInvariant(firstName[0]) + firstName[1..];
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] · Flexify</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymCrudApp.styles.css" asp-append-version="true" />
</head>
<body class="fx">
<div class="fx-admin fx-portal-shell">
    <nav class="fx-sidebar" aria-label="Member">
        <a class="fx-brand" asp-controller="MemberPortal" asp-action="Index">
            <partial name="_FxBrand" />
        </a>
        <a class="fx-nav-link is-active" asp-controller="MemberPortal" asp-action="Index" aria-current="page">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.4 8 8 9 4.6-1 8-4.5 8-9V6z" /></svg>
            My membership
        </a>
        <a class="fx-nav-link" href="#payments">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="13" rx="3" /><path d="M2 10h20" /><path d="M6 15h4" /></svg>
            Payments
        </a>
        <a class="fx-nav-link" href="#visits">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="3" /><path d="M3 9h18" /><path d="M8 2v4" /><path d="M16 2v4" /></svg>
            Visits
        </a>
        <a class="fx-nav-link" href="#plans">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3" /><path d="M7 9h10" /><path d="M7 13h6" /></svg>
            Plans
        </a>
        <div class="fx-sidebar__user">
            <div class="fx-list-row">
                <span class="fx-avatar">@FlexifyUi.Initials(User.Identity?.Name)</span>
                <div class="fx-list-row__body">
                    <strong>@firstName</strong>
                    <span>Member</span>
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="fx-btn fx-btn--outline fx-btn--sm fx-btn--block">Log out</button>
            </form>
        </div>
    </nav>

    <main class="fx-main">
        <partial name="_FxAlerts" />
        @RenderBody()
    </main>
</div>

<partial name="_ChatbotWidget" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
