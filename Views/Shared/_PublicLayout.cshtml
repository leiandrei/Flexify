@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isStaffSide = User.IsInRole("Admin") || User.IsInRole("Staff");
    var isMember = User.IsInRole("Member");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Flexify</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymCrudApp.styles.css" asp-append-version="true" />
</head>
<body class="fx">
<div class="fx-public">
    <header class="fx-top">
        <div class="fx-wrap fx-top__inner">
            <a class="fx-brand fx-top__brand" asp-controller="Home" asp-action="Index">
                <partial name="_FxBrand" />
            </a>
            <div class="fx-top__end">
                <nav class="fx-top__nav" aria-label="Site">
                    <a asp-controller="Home" asp-action="Index" asp-fragment="plans">Plans</a>
                    <a asp-controller="Home" asp-action="Index" asp-fragment="owners">For gym owners</a>
                    @if (signedIn)
                    {
                        @if (isStaffSide)
                        {
                            <a asp-controller="@(User.IsInRole("Admin") ? "AdminDashboard" : "Members")" asp-action="Index">Dashboard</a>
                        }
                        else if (isMember)
                        {
                            <a asp-controller="MemberPortal" asp-action="Index">My portal</a>
                        }
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login">Log in</a>
                    }
                </nav>
                @if (!signedIn)
                {
                    <a class="fx-btn fx-btn--primary" asp-controller="Account" asp-action="Register">Join</a>
                }
                else
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" class="fx-top__logout">
                        <button type="submit" class="fx-btn fx-btn--ghost">Log out</button>
                    </form>
                }
            </div>
        </div>
    </header>

    <main>
        @if (TempData.Peek("SuccessMessage") != null || TempData.Peek("WarningMessage") != null || TempData.Peek("ErrorMessage") != null)
        {
            <div class="fx-wrap" style="padding-top:16px">
                <partial name="_FxAlerts" />
            </div>
        }
        @RenderBody()
    </main>

    <footer class="fx-foot">
        <div class="fx-wrap fx-foot__inner">
            <span>&copy; 2026 Flexify</span>
            <nav class="fx-foot__nav" aria-label="Footer">
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </nav>
        </div>
    </footer>
</div>

<partial name="_ChatbotWidget" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
