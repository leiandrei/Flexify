@model GymCrudApp.ViewModels.MembershipPlans.MembershipPlanFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Plan";
}

<header class="fx-page-head">
    <div class="fx-stack fx-stack--sm">
        <h1>Edit plan</h1>
        <p class="fx-muted">@Model.PlanName</p>
    </div>
</header>

<form asp-action="Edit" asp-route-id="@Model.PlanId" method="post" class="fx-card fx-form fx-narrow">
    <input type="hidden" asp-for="PlanId" />
    <div asp-validation-summary="ModelOnly"></div>

    <div class="fx-field">
        <label asp-for="PlanName" class="fx-label"></label>
        <input asp-for="PlanName" class="fx-input" />
        <span asp-validation-for="PlanName" class="fx-error"></span>
    </div>

    <div class="fx-field">
        <label asp-for="PlanPrice" class="fx-label"></label>
        <input asp-for="PlanPrice" class="fx-input" step="0.01" min="0.01" />
        <span asp-validation-for="PlanPrice" class="fx-error"></span>
    </div>

    <div class="fx-field">
        <label asp-for="DurationDays" class="fx-label"></label>
        <input asp-for="DurationDays" class="fx-input" min="1" max="3650" />
        <span asp-validation-for="DurationDays" class="fx-error"></span>
    </div>

    <div class="fx-field">
        <label asp-for="PlanDescription" class="fx-label"></label>
        <textarea asp-for="PlanDescription" class="fx-textarea" rows="4"></textarea>
        <span asp-validation-for="PlanDescription" class="fx-error"></span>
    </div>

    <div class="fx-check">
        <input asp-for="IsActive" />
        <label asp-for="IsActive"></label>
    </div>

    <div class="fx-form__actions">
        <button type="submit" class="fx-btn fx-btn--primary">Update plan</button>
        <a asp-action="Index" class="fx-btn fx-btn--ghost">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}