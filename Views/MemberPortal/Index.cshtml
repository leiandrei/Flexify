@model GymCrudApp.ViewModels.MemberPortal.MemberPortalViewModel
@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "My membership";
    var firstName = Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? Model.FullName;
    int? usedDays = null;
    int? totalDays = Model.PlanDurationDays;
    int? usedPercent = null;
    if (Model.StartDate.HasValue && Model.ExpiryDate.HasValue)
    {
        var span = (Model.ExpiryDate.Value - Model.StartDate.Value).TotalDays;
        if (span > 0)
        {
            totalDays ??= (int)Math.Round(span);
            usedDays = (int)Math.Clamp(Math.Round(span - Model.DaysRemaining), 0, totalDays.Value);
            usedPercent = (int)Math.Clamp(Math.Round(usedDays.Value * 100.0 / totalDays.Value), 0, 100);
        }
    }
    var pillClass = Model.MembershipStatus switch
    {
        "Active" => "is-active",
        "Expiring" => "is-expiring",
        "Expired" => "is-expired",
        _ => "is-inactive"
    };
    var daysLabel = Model.DaysRemaining == 1 ? "day left" : "days left";
}

<div class="fx-portal">
    <header class="fx-page-head">
        <div>
            <h1>Hi, @firstName</h1>
            <p class="fx-muted">@DateTime.Today.ToString("dddd, MMMM d, yyyy")</p>
        </div>
    </header>

    <section class="fx-portal__status" aria-label="Membership status">
        <div>
            <span class="fx-members__pill @pillClass">@Model.MembershipStatus</span>
            @if (Model.ExpiryDate.HasValue)
            {
                <p class="fx-portal__days">@Model.DaysRemaining <span>@daysLabel</span></p>
            }
            else
            {
                <p class="fx-portal__days">—<span>no plan yet</span></p>
            }
        </div>
        <dl class="fx-dl">
            <dt>Plan</dt>
            <dd>
                @if (!string.IsNullOrWhiteSpace(Model.PlanName))
                {
                    @Model.PlanName
                    @if (Model.PlanPrice.HasValue && Model.PlanDurationDays.HasValue)
                    {
                        <text> · @FlexifyUi.Peso(Model.PlanPrice.Value) / @Model.PlanDurationDays days</text>
                    }
                }
                else
                {
                    <text>No plan yet</text>
                }
            </dd>
            <dt>Started</dt>
            <dd>@(Model.StartDate?.ToString("MMM d, yyyy") ?? "—")</dd>
            <dt>Ends</dt>
            <dd>@(Model.ExpiryDate?.ToString("MMM d, yyyy") ?? "—")</dd>
        </dl>
        @if (usedPercent.HasValue)
        {
            <div class="fx-portal__used" role="img" aria-label="@usedDays of @totalDays days used">
                <span style="width:@usedPercent%"></span>
            </div>
            <p class="fx-muted fx-portal__used-note">
                @usedDays of @totalDays days used.
                @if (Model.MembershipStatus is "Active" or "Expiring")
                {
                    <text> Renew at the front desk before @Model.ExpiryDate!.Value.ToString("MMM d").</text>
                }
                else if (Model.MembershipStatus == "Expired")
                {
                    <text> Visit the front desk to renew.</text>
                }
            </p>
        }
        else if (!Model.ExpiryDate.HasValue)
        {
            <p class="fx-muted fx-portal__used-note">You don’t have a membership yet. Pick a plan below, then pay at the front desk.</p>
        }
    </section>

    @if (Model.Payments.Any())
    {
        <section class="fx-section" id="payments" aria-labelledby="pay-h">
            <div class="fx-section__head">
                <h2 id="pay-h">Payment history</h2>
                <span class="fx-muted" style="font-size:13px">@Model.Payments.Count @(Model.Payments.Count == 1 ? "payment" : "payments")</span>
            </div>
            <div class="fx-members__table-wrap">
                <table class="fx-members__table">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Plan</th>
                            <th scope="col">Method</th>
                            <th scope="col">Reference</th>
                            <th scope="col" class="fx-num">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Payments)
                        {
                            <tr class="@(p.IsVoided ? "is-void" : null)">
                                <td>@p.PaymentDate.ToString("MMM d, yyyy")</td>
                                <td>@p.PlanName</td>
                                <td>@p.PaymentType</td>
                                <td>@(string.IsNullOrWhiteSpace(p.ReferenceNumber) ? "—" : p.ReferenceNumber)</td>
                                <td class="fx-num">
                                    @if (p.IsVoided)
                                    {
                                        <span class="fx-badge fx-badge--overdue">Voided</span>
                                    }
                                    else
                                    {
                                        @FlexifyUi.Peso(p.Amount)
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (Model.AttendanceLogs.Any())
    {
        <section class="fx-section" id="visits" aria-labelledby="vis-h">
            <div class="fx-section__head">
                <h2 id="vis-h">Gym visits</h2>
                <span class="fx-muted" style="font-size:13px">@Model.VisitsThisMonth this month</span>
            </div>
            <div class="fx-members__table-wrap">
                <table class="fx-members__table">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Checked in</th>
                            <th scope="col">Checked out</th>
                            <th scope="col" class="fx-num">Time spent</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.AttendanceLogs.Take(12))
                        {
                            var isToday = a.CheckIn.Date == DateTime.Today;
                            <tr>
                                <td>@(isToday ? "Today" : a.CheckIn.ToString("MMM d"))</td>
                                <td>@a.CheckIn.ToString("h:mm tt")</td>
                                <td>
                                    @if (!a.CheckOut.HasValue)
                                    {
                                        <span class="fx-members__pill is-active">On the floor</span>
                                    }
                                    else
                                    {
                                        @a.CheckOut.Value.ToString("h:mm tt")
                                    }
                                </td>
                                <td class="fx-num">@a.DurationDisplay</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section class="fx-section" id="plans" aria-labelledby="plans-h">
        <div class="fx-section__head">
            <h2 id="plans-h">@(Model.ExpiryDate.HasValue ? "Change or renew" : "Choose a plan")</h2>
            <span class="fx-muted" style="font-size:13px">Pay at the front desk — not in this app</span>
        </div>
        @if (!Model.AvailablePlans.Any())
        {
            <p class="fx-muted">No plans are published right now.</p>
        }
        else
        {
            var defaultPlan = Model.AvailablePlans.FirstOrDefault(p => p.IsCurrent) ?? Model.AvailablePlans.First();
            var defaultAction = defaultPlan.IsCurrent
                ? (Model.MembershipStatus is "Expiring" or "Expired" ? "Renew this plan at the front desk" : "This is your current plan")
                : (Model.MembershipStatus is "No Membership" or "Expired" or "Inactive"
                    ? "Next: pay for this plan at the front desk"
                    : "Next: ask the front desk to switch to this plan");
            <div class="fx-plans" id="portalPlanPicker" style="--n:@Model.AvailablePlans.Count">
                @foreach (var plan in Model.AvailablePlans)
                {
                    var pressed = plan.PlanId == defaultPlan.PlanId;
                    var action = plan.IsCurrent
                        ? (Model.MembershipStatus is "Expiring" or "Expired" ? "Renew this plan at the front desk" : "This is your current plan")
                        : (Model.MembershipStatus is "No Membership" or "Expired" or "Inactive"
                            ? "Next: pay for this plan at the front desk"
                            : "Next: ask the front desk to switch to this plan");
                    <button type="button"
                            class="fx-plan"
                            aria-pressed="@(pressed ? "true" : "false")"
                            data-n="@plan.PlanName"
                            data-p="@FlexifyUi.Peso(plan.PlanPrice)"
                            data-current="@(plan.IsCurrent ? "1" : "0")"
                            data-action="@action">
                        <span class="fx-plan__n">
                            @plan.PlanName
                            @if (plan.IsCurrent)
                            {
                                <span class="fx-plan__tag">Current</span>
                            }
                        </span>
                        <span class="fx-plan__p">@FlexifyUi.Peso(plan.PlanPrice)</span>
                        <span class="fx-plan__d">@plan.DurationDays @(plan.DurationDays == 1 ? "day" : "days")</span>
                        <span class="fx-plan__x">@(string.IsNullOrWhiteSpace(plan.PlanDescription) ? "Full gym floor access." : plan.PlanDescription)</span>
                    </button>
                }
            </div>
            <div class="fx-pick-row fx-pick-row--portal">
                <p class="fx-muted">
                    Selected:
                    <b id="portalPlanSel" style="color:var(--fx-ink)">@defaultPlan.PlanName · @FlexifyUi.Peso(defaultPlan.PlanPrice)</b>
                </p>
            </div>
            <div class="fx-portal__desk-note" id="portalPlanAction" role="note">
                <strong id="portalPlanActionTitle">@defaultAction</strong>
                <p>This app doesn’t take payments. Bring cash, GCash, Maya, card, or bank transfer to the desk and they’ll activate it the same day.</p>
            </div>
        }
    </section>
</div>

@section Scripts {
<script>
(() => {
  const buttons = document.querySelectorAll('#portalPlanPicker .fx-plan');
  const sel = document.getElementById('portalPlanSel');
  const title = document.getElementById('portalPlanActionTitle');
  if (!buttons.length || !sel) return;
  buttons.forEach(btn => btn.addEventListener('click', () => {
    buttons.forEach(o => o.setAttribute('aria-pressed', o === btn ? 'true' : 'false'));
    sel.textContent = `${btn.dataset.n} · ${btn.dataset.p}`;
    if (title) title.textContent = btn.dataset.action || 'Pay at the front desk';
  }));
})();
</script>
}
